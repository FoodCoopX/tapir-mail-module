<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial" />
    </mj-attributes>
  </mj-head>
  <mj-body
    background-color="#ffffff"
    width="600px"
  >
    <mj-section>
      <mj-column>
        <mj-text>LAYOUT HEADER</mj-text>
      </mj-column>
    </mj-section>
    {{Body}}
    <mj-section>
      <mj-column>
        <mj-text>LAYOUT FOOTER</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
