<mjml>
  <mj-head>
    <mj-html-attributes>
      <mj-html-attribute
        class="easy-email"
        multiple-attributes="false"
        attribute-name="text-color"
        text-color="#000000"
      ></mj-html-attribute>
      <mj-html-attribute
        class="easy-email"
        multiple-attributes="false"
        attribute-name="font-family"
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans','Helvetica Neue', sans-serif"
      ></mj-html-attribute>
      <mj-html-attribute
        class="easy-email"
        multiple-attributes="false"
        attribute-name="font-size"
        font-size="14px"
      ></mj-html-attribute>
      <mj-html-attribute
        class="easy-email"
        multiple-attributes="false"
        attribute-name="line-height"
        line-height="1.7"
      ></mj-html-attribute>
      <mj-html-attribute
        class="easy-email"
        multiple-attributes="false"
        attribute-name="font-weight"
        font-weight="400"
      ></mj-html-attribute>
      <mj-html-attribute
        class="easy-email"
        multiple-attributes="false"
        attribute-name="responsive"
        responsive="true"
      ></mj-html-attribute>
    </mj-html-attributes>

    <mj-breakpoint width="480px" />

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text
        color="#2f3b45"
        font-size="14px"
        line-height="1.6"
      />
      <mj-button
        background-color="#1a73e8"
        color="#ffffff"
        border-radius="4px"
      />
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans','Helvetica Neue', sans-serif"
      />
      <mj-text font-size="14px" />
      <mj-text color="#000000" />
      <mj-text line-height="1.7" />
      <mj-text font-weight="400" />
    </mj-attributes>
  </mj-head>
  <mj-body
    background-color="#eef1f5"
    width="600px"
  >
    <mj-section
      padding="24px 24px 20px 24px"
      border="none"
      direction="ltr"
      text-align="center"
      background-repeat="repeat"
      background-size="auto"
      background-position="top center"
      background-color="#1a73e8"
    >
      <mj-column
        border="none"
        vertical-align="top"
        padding="0px 0px 0px 0px"
      >
        <mj-text
          align="left"
          font-size="20px"
          font-weight="bold"
          color="#ffffff"
          padding="0px 0px 0px 0px"
        >
          Vereinsname
        </mj-text>
        <mj-text
          align="left"
          font-size="13px"
          color="#dce8fb"
          padding="6px 0px 0px 0px"
        >
          Mitteilungen aus dem Verein
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      padding="0px"
      text-align="left"
    >
      <mj-column>
        <mj-image
          align="center"
          height="auto"
          padding="0px 0px 0px 0px"
          src="https://upload.wikimedia.org/wikipedia/commons/0/01/TapirAtSDZ.jpg"
        ></mj-image>
      </mj-column>
    </mj-section>
    <mj-section
      background-repeat="repeat"
      background-size="auto"
      background-position="top center"
      border="none"
      direction="ltr"
      text-align="center"
      css-class="tapir-layout-body"
      background-color="#ffffff"
      padding="0px 0px 0px 0px"
    >
      <mj-column
        border="none"
        vertical-align="top"
        padding="0px 0px 0px 0px"
      >
        <mj-text
          align="left"
          padding="24px 24px 24px 24px"
        >
          {{ Body }}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      background-repeat="repeat"
      background-size="auto"
      background-position="top center"
      border="none"
      direction="ltr"
      text-align="center"
      background-color="#ffffff"
      padding="0px 0px 0px 0px"
    >
      <mj-column
        border="none"
        vertical-align="top"
        padding="0px 0px 0px 0px"
      >
        <mj-divider
          align="center"
          border-width="1px"
          border-style="solid"
          border-color="#e3e8ee"
          padding="0px 0px 0px 0px"
        ></mj-divider>
      </mj-column>
    </mj-section>
    <mj-section
      background-repeat="repeat"
      background-size="auto"
      background-position="top center"
      border="none"
      direction="ltr"
      text-align="center"
      background-color="#ffffff"
      padding="0px 0px 0px 0px"
    >
      <mj-column
        border="none"
        vertical-align="top"
        padding="0px 0px 0px 0px"
      >
        <mj-divider
          align="center"
          border-width="1px"
          border-style="solid"
          border-color="#e3e8ee"
          padding="0px 0px 0px 0px"
        ></mj-divider>
      </mj-column>
    </mj-section>
    <mj-section
      background-repeat="repeat"
      background-size="auto"
      background-position="top center"
      border="none"
      direction="ltr"
      text-align="center"
      background-color="#f7f8fa"
      padding="20px 24px 24px 24px"
    >
      <mj-column
        border="none"
        vertical-align="top"
        padding="0px 0px 0px 0px"
      >
        <mj-text
          align="center"
          font-size="12px"
          color="#6b7785"
          padding="0px 0px 0px 0px"
        >
          Du erhältst diese E-Mail, weil du bei uns registriert bist.
        </mj-text>
        <mj-text
          align="center"
          font-size="12px"
          color="#6b7785"
          padding="8px 0px 0px 0px"
        >
          <a
            href="https://example.org/impressum"
            style="color: #1a73e8"
          >
            Impressum
          </a>
          ·
          <a
            href="https://example.org/datenschutz"
            style="color: #1a73e8"
          >
            Datenschutz
          </a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
